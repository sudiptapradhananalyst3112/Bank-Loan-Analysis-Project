      <aliases enabled='yes' />
      <column caption='Total Loan Applications' datatype='integer' name='[Calculation_1078943065571328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([id])' />
      </column>
      <column caption='MTD Loan Applications' datatype='integer' name='[Calculation_1078943068868609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF  &#13;&#10;DATEDIFF(&apos;month&apos; , [issue_date] ,{ MAX([issue_date])})=0&#13;&#10;THEN&#13;&#10;[id]&#13;&#10;END)' />
      </column>
      <column caption='MOM Total Loan ' datatype='real' name='[Calculation_1078943072956424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1078943068868609]-[MTD Loan Applications (copy)_1078943073472521])/[MTD Loan Applications (copy)_1078943073472521]' />
      </column>
      <column caption='Total Funded Amount' datatype='integer' name='[Calculation_1078943077347339]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([loan_amount])' />
      </column>
      <column caption='MoM Total Funded Amount ' datatype='real' name='[Calculation_1078943083917329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Loan Applications (copy)_1078943078932492]-[MTD Total Funded Amount (copy)_1078943080841230])/[MTD Total Funded Amount (copy)_1078943080841230]' />
      </column>
      <column caption='Total Amount Received ' datatype='integer' name='[Calculation_1078943084937234]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_payment])' />
      </column>
      <column caption='MOM Total Amount Received ' datatype='real' name='[Calculation_1078943089881109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Total Funded Amount (copy)_1078943085953043]-[MTD Total Amount Received  (copy)_1078943088427028])/[MTD Total Amount Received  (copy)_1078943088427028]' />
      </column>
      <column caption='Avg Interest Rate ' datatype='real' name='[Calculation_1078943093977110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([int_rate])' />
      </column>
      <column caption='MOM Avg INT Rate ' datatype='real' name='[Calculation_1078943098150938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([MTD Loan Applications (copy)_1078943096426519]-[MTD Avg Int Rate  (copy)_1078943098028057])/[MTD Avg Int Rate  (copy)_1078943098028057]' />
      </column>
      <column caption='Avg DTI' datatype='real' name='[Calculation_1078943099908123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([dti])' />
      </column>
